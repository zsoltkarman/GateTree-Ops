{
  "jira": {
    "id": "jira",
    "defaults": {
      "headers": { "Accept": "application/json", "Content-Type": "application/json" },
      "timeout_seconds": 30,
      "verify_tls": true
    },
    "actions": {
      "validate": {
        "request": { "method": "GET", "path": "/rest/api/2/issue/{{input.issue_key}}" },
        "success": { "status_codes": [200] },
        "output": {
          "issue_key": "$.key",
          "summary": "$.fields.summary",
          "description": "$.fields.description",
          "status": "$.fields.status.name",
          "assignee": "$.fields.assignee.displayName",
          "reporter": "$.fields.reporter.displayName"
        }
      },
      "update": { "implementation": "native", "configuration": "step.report" }
    }
  },
  "cx": {
    "id": "cx",
    "defaults": { "timeout_seconds": 30, "verify_tls": true },
    "actions": {
      "validate": { "implementation": "pending" },
      "update": { "implementation": "native", "configuration": "step.report" }
    }
  },
  "olam": {
    "id": "olam",
    "defaults": { "timeout_seconds": 30, "verify_tls": true },
    "actions": {
      "validate": { "implementation": "native" },
      "validate_deployment": { "implementation": "native" },
      "deploy": { "implementation": "pending" }
    }
  }
}
